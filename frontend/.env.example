# Public origin of the SmartBuy API, without a trailing slash. Leave empty when the API is reached on the same
# origin (Vite dev proxy, or a Netlify /api proxy rule).
VITE_API_BASE_URL=

# Local development only: where the Vite dev server proxies /api to.
VITE_DEV_API_TARGET=http://localhost:5080

# Address the landing-page contact form opens in the visitor's email app. Leave empty to show it as unavailable.
VITE_CONTACT_EMAIL=
