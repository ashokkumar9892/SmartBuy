# FindMyPrice API configuration. ASP.NET Core reads these as environment variables (double underscore = section).
# Copy to .env for Docker Compose, or set them as machine / app-pool environment variables on Windows + IIS.
# Never commit real values.

ASPNETCORE_ENVIRONMENT=Production

# --- Database (PostgreSQL in production) ---
Database__Provider=postgres
Database__ConnectionString=Host=localhost;Port=5432;Database=smartbuy;Username=smartbuy;Password=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# --- Authentication ---
# Random secret, at least 32 characters.
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
Jwt__Key=
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=14
# Google sign-in stays disabled until a client ID is set.
Google__ClientId=
# Facebook Login stays disabled until both are set. GraphVersion must be a version Meta still supports.
Facebook__AppId=
Facebook__AppSecret=
Facebook__GraphVersion=v21.0

# --- Frontend origin (CORS and billing redirects) ---
App__FrontendUrl=https://your-site.netlify.app
Cors__AllowedOrigins__0=https://your-site.netlify.app

# --- First start ---
Seed__DemoData=true
Seed__AdminEmail=
Seed__AdminPassword=

# --- AI provider: mock | claude | openai ---
Ai__Provider=mock
Ai__Claude__ApiKey=
Ai__Claude__Model=claude-opus-5-5
Ai__OpenAi__ApiKey=
Ai__OpenAi__Model=

# --- Purchase-order email delivery (optional). Without it, POs can be exported or recorded as sent manually. ---
Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=

# --- Stripe (optional; use test keys in development) ---
Billing__StripeSecretKey=
Billing__StripeWebhookSecret=
Billing__Prices__pro=
Billing__Prices__business=
Billing__AllowManualPlanChange=false

# --- Background jobs ---
Jobs__PriceAlertSchedulerEnabled=false
Jobs__PriceAlertIntervalMinutes=60

# --- Limits ---
RateLimits__GlobalPerMinute=300
RateLimits__AuthPerMinute=10
RateLimits__AiPerMinute=20
Suppliers__TimeoutSeconds=8

# Expose Swagger UI outside Development (off by default).
Swagger__Enabled=false
